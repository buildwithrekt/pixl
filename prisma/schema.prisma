// PIXELBOARD Database Schema
// 1024×1024 pixel canvas, 8×8 cell grid (128×128 = 16,384 cells)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// Zone - A purchased rectangular area
// ========================================
model Zone {
  id            String     @id @default(cuid())

  // Position in cells (8×8 px each), not pixels
  x             Int        // 0-127
  y             Int        // 0-127
  w             Int        // width in cells (min 1)
  h             Int        // height in cells (min 1)

  // Owner
  wallet        String     // Wallet address (current owner)

  // Status flow: reserved → paid → drawn
  status        ZoneStatus @default(RESERVED)

  // Pricing (frozen at reservation time)
  pricePerPixel Int        // $PIXEL per pixel at reservation
  totalPixels   Int        // w * h * 64 (cells to pixels)
  totalPrice    BigInt     // pricePerPixel * totalPixels

  // Marketplace: tier at purchase (for floor price calculation)
  purchaseTier       Int?  // Tier when first bought (1-6)
  purchaseMultiplier Int?  // Multiplier at purchase (1,2,4,8,16,32)
  previousOwner      String? // Previous owner (set on resale)

  // Reservation
  reservationId String     @unique // UUID for payment memo
  expiresAt     DateTime?  // TTL for reservation (10 min)

  // Payment verification
  txSignature   String?    // Solana tx signature
  blockTime     DateTime?  // On-chain confirmation time
  paidAt        DateTime?

  // Content
  imageUrl         String?    // Resized image URL (for canvas composite)
  originalImageUrl String?    // Original full-resolution image URL (for gallery/preview)
  projectName      String?    // Optional project name
  projectLink      String?    // Optional link

  // Metadata
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  listing       Listing?   // Active marketplace listing

  @@index([wallet])
  @@index([status])
  @@index([reservationId])
  @@index([expiresAt])
}

enum ZoneStatus {
  RESERVED  // Locked, awaiting payment
  PAID      // Payment confirmed
  DRAWN     // Image uploaded and composited
  EXPIRED   // Reservation expired (cleanup)
  REFUNDED  // Payment refunded
}

// ========================================
// PriceState - Singleton for pricing tiers
// ========================================
model PriceState {
  id            String   @id @default("singleton")

  // Current state
  pixelsSold    Int      @default(0)     // Total pixels sold
  currentTier   Int      @default(1)     // Current price tier
  basePrice     Int      @default(10)    // Base price in $PIXEL

  // Tier thresholds (percentage of total pixels)
  // Tier 1: 0-10% = 1x, Tier 2: 10-25% = 2x, etc.

  // History for analytics
  history       Json     @default("[]")  // Array of {tier, price, timestamp, pixelsSold}

  updatedAt     DateTime @updatedAt
}

// ========================================
// Event - Append-only log for timelapse
// ========================================
model Event {
  id        String    @id @default(cuid())
  type      EventType
  zoneId    String?
  wallet    String?
  data      Json      @default("{}")
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([zoneId])
  @@index([createdAt])
}

enum EventType {
  ZONE_RESERVED
  ZONE_PAID
  ZONE_DRAWN
  ZONE_EXPIRED
  ZONE_REFUNDED
  ZONE_LISTED
  ZONE_UNLISTED
  ZONE_SOLD
  PRICE_TIER_CHANGE
  BURN_EXECUTED
  COMPOSITE_UPDATED
  PAYMENT_RECOVERED
  ORPHAN_PAYMENT
}

// ========================================
// BurnTx - Treasury burn records
// ========================================
model BurnTx {
  id          String   @id @default(cuid())

  amount      BigInt   // $PIXEL burned
  txSignature String   @unique
  blockTime   DateTime

  // Context
  trigger     String?  // "weekly", "tier_change", "manual"
  tier        Int?     // Price tier at burn time

  createdAt   DateTime @default(now())

  @@index([blockTime])
}

// ========================================
// OrphanPayment - Payments with bad/expired memo
// ========================================
model OrphanPayment {
  id          String   @id @default(cuid())

  wallet      String
  amount      BigInt
  memo        String?
  txSignature String   @unique
  blockTime   DateTime

  // Recovery status
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolution  String?  // "refunded", "matched", "manual"

  createdAt   DateTime @default(now())

  @@index([wallet])
  @@index([resolved])
}

// ========================================
// Snapshot - Canvas state for timelapse
// ========================================
model Snapshot {
  id          String   @id @default(cuid())

  imageUrl    String   // Stored composite URL
  pixelsSold  Int
  zonesCount  Int
  tier        Int

  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ========================================
// Listing - Zone for sale on marketplace
// ========================================
model Listing {
  id          String        @id @default(cuid())

  // Zone reference
  zoneId      String        @unique
  zone        Zone          @relation(fields: [zoneId], references: [id])

  // Seller
  seller      String        // Wallet address (must match zone.wallet)

  // Pricing
  askingPrice BigInt        // $PIXEL asking price
  floorPrice  BigInt        // Calculated floor (cannot sell below)

  // Metadata for floor calculation
  purchaseTier       Int    // Tier when zone was originally bought
  purchaseMultiplier Int    // Multiplier at purchase (1,2,4,8,16,32)

  // Status
  status      ListingStatus @default(ACTIVE)

  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime      // Auto-expire after 30 days

  @@index([seller])
  @@index([status])
  @@index([askingPrice])
  @@index([expiresAt])
}

enum ListingStatus {
  ACTIVE      // Available for purchase
  SOLD        // Sale completed
  CANCELLED   // Seller cancelled
  EXPIRED     // Listing expired
}

// ========================================
// Sale - Completed marketplace transaction
// ========================================
model Sale {
  id             String    @id @default(cuid())

  // References
  zoneId         String
  listingId      String?   // Null if direct transfer (future)

  // Parties
  seller         String    // Seller wallet
  buyer          String    // Buyer wallet

  // Pricing
  salePrice      BigInt    // Final sale price
  platformFee    BigInt    // 5% fee
  sellerProceeds BigInt    // 95% to seller

  // Tier context
  tierAtSale     Int

  // Payment verification
  txSignature    String?   // On-chain tx
  blockTime      DateTime?

  createdAt      DateTime  @default(now())

  @@index([zoneId])
  @@index([seller])
  @@index([buyer])
  @@index([createdAt])
}
