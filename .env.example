# ========================================
# PIXELBOARD Environment Variables
# ========================================

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host:5432/pixelboard?sslmode=require"

# Robinhood Chain
NEXT_PUBLIC_CHAIN_ENV="testnet"  # "testnet" or "mainnet"
NEXT_PUBLIC_ALCHEMY_API_KEY="your-alchemy-api-key"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# $PIXEL Token (ERC20)
NEXT_PUBLIC_PIXEL_TOKEN_ADDRESS="0x..."  # ERC20 contract address

# Treasury
TREASURY_WALLET="0x..."  # Treasury wallet address

# Alchemy (webhook for payment verification)
ALCHEMY_WEBHOOK_SIGNING_KEY="your-alchemy-webhook-key"

# Image Storage (Vercel Blob or S3)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Secret (for scheduled jobs)
CRON_SECRET="your-cron-secret"
